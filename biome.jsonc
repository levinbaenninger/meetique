{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/next",
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "linter": {
    "rules": {
      "complexity": {
        "noVoid": "off"
      },
      "style": {
        "useConsistentTypeDefinitions": "off"
      }
    },
    "includes": ["src/**", "!src/components/ui/**"]
  }
}
